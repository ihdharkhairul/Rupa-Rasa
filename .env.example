# ===================================================
# KONFIGURASI TOKO RUPARASA KULINER
# ===================================================
# Nama toko yang ditampilkan pada website dan pesan WhatsApp
NEXT_PUBLIC_STORE_NAME="RupaRasa Kuliner"

# Nomor WhatsApp Toko (Format kode negara tanpa '+', spasi, atau strip, contoh: 62881080735942)
NEXT_PUBLIC_STORE_WHATSAPP="62881080735942"

# Username Instagram Toko (tanpa tanda '@', contoh: ruparasa_kuliner)
NEXT_PUBLIC_STORE_INSTAGRAM=""

# Alamat fisik / dapur toko
NEXT_PUBLIC_STORE_ADDRESS="Jl. Kuliner Nusantara No. 88, Kebayoran Baru, Jakarta Selatan 12180"

# ===================================================
# MIDTRANS PAYMENT GATEWAY (QRIS DINAMIS)
# ===================================================
# Server Key Midtrans (Hanya digunakan di sisi Server / Route Handlers, JANGAN PERNAH DIEKSPOS KE BROWSER)
# Ambil dari: Dashboard Midtrans -> Settings -> Access Keys
# Jika belum diisi atau masih berupa placeholder, sistem otomatis berjalan dalam Mode Demo
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"

# Client Key Midtrans (Opsional untuk frontend)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"

# Mode Lingkungan Midtrans ('false' untuk Sandbox pengujian, 'true' untuk Production komersial)
MIDTRANS_IS_PRODUCTION="false"

# ===================================================
# KEAMANAN SESI PESANAN (STATELESS)
# ===================================================
# Kunci rahasia untuk menandatangani session token pesanan (HMAC-SHA256)
ORDER_SESSION_SECRET="ruparasa-secret-key-production-change-this-to-a-random-string"
